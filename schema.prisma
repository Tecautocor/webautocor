generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Banner {
  id        Int       @id @default(autoincrement())
  src       String
  href      String
  external  Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  startsAt  DateTime?
  endsAt    DateTime?
  createdBy String?
  active    Boolean   @default(true)
}

model Phone {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  category  String
  phone     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Historial de cambios de números telefónicos. Solo se inserta, nunca se
// actualiza ni se borra desde la app (ningún endpoint expone UPDATE/DELETE
// para este modelo) - es el registro permanente de quién cambió qué.
model PhoneChangeLog {
  id        Int      @id @default(autoincrement())
  phoneKey  String
  label     String
  oldValue  String
  newValue  String
  changedBy String
  changedAt DateTime @default(now())
}

// Un registro por cada venta "APROBADA JEFATURA" que pasa por el matching
// de catálogo Ecuaprimas (pilotSaleWebhook) - alimenta el tablero de control
// en /admin/ecuaprimas. No guarda datos del cliente (cédula, teléfono,
// dirección), solo lo del vehículo y el resultado del match.
model EcuaprimasMatchLog {
  id                   Int      @id @default(autoincrement())
  ventaId              String
  marca                String?
  modelo               String?
  version              String?
  color                String?
  matchOk              Boolean
  motivo               String?
  marcaCodigo          String?
  modeloCodigo         String?
  modeloNombreCatalogo String?
  modeloCobertura      Float?
  colorCodigo          String?
  createdAt            DateTime @default(now())
  numeroCertificado    String?
  cotizacionEnviada    Boolean  @default(false)
  enviadoA             String?
  errorCotizacion      String?
}

// Log crudo del webhook de Ventas de Pilot (entidad "Ventas"). Guarda el
// payload completo tal cual llega (rawPayload) mas un set de campos clave ya
// tipados para consultar sin parsear JSON. No guarda PII del cliente (cedula,
// domicilio, conyuge) - solo lo necesario para dashboards gerenciales, mismo
// criterio que EcuaprimasMatchLog. Los campos tipados se llenan una vez que
// se conozca la forma real del payload (ver rawPayload de los primeros
// eventos recibidos) - hasta entonces pueden quedar en null.
model VentaWebhookLog {
  id                        Int       @id @default(autoincrement())
  ventaId                   String?
  estado                    String?
  tipoNegocio               String?
  origen                    String?
  suborigen                 String?
  fechaAlta                 DateTime?
  fechaAprobacion           DateTime?
  marca                     String?
  modelo                    String?
  version                   String?
  color                     String?
  precioLista               Float?
  montoEfectivo             Float?
  montoFinanciado           Float?
  montoRetomaUsado          Float?
  gastosEntrega             Float?
  totalTransaccion          Float?
  pctDescuento              Float?
  descuentoVendedor         Float?
  descuentoGerente          Float?
  banco                     String?
  cuotasFinanciadas         Int?
  montoCuota                Float?
  tasaFinanciacion          Float?
  usadoMarca                String?
  usadoModelo               String?
  usadoValorEstimado        Float?
  usadoCostoReparacion      Float?
  usadoRentabilidadEstimada Float?
  vendedorNombre            String?
  sucursal                  String?
  comisionVendedor          Float?
  rawPayload                Json?
  receivedAt                DateTime  @default(now())
}

// Meta de unidades a vender por agencia/mes, definida por Gerencia. No sale
// de ningun sistema (Pilot no tiene un concepto de "presupuesto") - se
// captura a mano una vez por periodo desde /admin/metas.
model MetaVentas {
  id           Int      @id @default(autoincrement())
  anio         Int
  mes          Int
  agencia      String
  metaUnidades Int
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@unique([anio, mes, agencia])
}

// Registro propio de leads generados por los formularios del sitio (hoy solo
// se mandan a Pilot via webhooks/welcome.php, sin guardar copia local). Se
// usa para el dashboard de Embudo de Conversion - arranca a capturar desde
// que se activa este modelo, no tiene historico previo.
model LeadLog {
  id         Int      @id @default(autoincrement())
  formulario String
  suborigen  String?
  nombre     String?
  email      String?
  telefono   String?
  ciudad     String?
  createdAt  DateTime @default(now())
}

model Vehicle {
  id_record                  Int       @id @unique(map: "id") @default(autoincrement())
  id                         String?
  media                      String?
  brand                      String?
  model                      String?
  prices                     Int?
  year                       Int?
  owner                      Int?
  home                       Int?
  odometer                   Int?
  type                       String?
  location                   String?
  business_channel           String?
  processedAt                DateTime? @default(now())
  color                      String?   @db.VarChar(100)
  accesories                 String?   @db.VarChar(100)
  license_plate              String?   @db.VarChar(10)
  received_flag              String?   @db.VarChar(10)
  days_in_stock              String?   @db.VarChar(10)
  published_in_web           String?   @db.VarChar(10)
  engine_number              String?   @db.VarChar(100)
  reserved_by_user_email     String?   @db.VarChar(100)
  reserved_by_user_name      String?   @db.VarChar(100)
  reserved_dt                DateTime? @db.DateTime(0)
  expiration_dt              DateTime? @db.DateTime(0)
  opportunity_sale_id        String?   @db.VarChar(100)
  factory_invoicing_dt       DateTime? @db.DateTime(0)
  factory_status             String?   @db.VarChar(100)
  status_name                String?   @db.VarChar(100)
  fuel_name                  String?   @db.VarChar(100)
  availability_status_name   String?   @db.VarChar(100)
  availability_status_code   String?   @db.VarChar(100)
  created_fullname           String?   @db.VarChar(100)
  created_dt                 DateTime? @db.DateTime(0)
  deleted_flag               String?   @db.VarChar(10)
  owner_branch_code          String?   @db.VarChar(100)
  saving_plan_group          String?   @db.VarChar(100)
  saving_plan_order          String?   @db.VarChar(100)
  integration_reference_code String?   @db.VarChar(100)
  version                    String?   @db.VarChar(100)
  purchase_price             Int?
}

